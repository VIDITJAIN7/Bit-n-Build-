# Copy this file to .env. The development launcher passes it only to the API.
WORKKITE_DATABASE=./data/averlock.db
WORKKITE_AGENT=rules
WORKKITE_WALLET=local
WORKKITE_AGENT_INTERVAL=5

# Optional AI operations commander. It plans task handling, timing, priority,
# and assignee. Deterministic policy still gates purchases and execution.
# Gemini example (server-side only; never use a VITE_ prefix for the API key):
# WORKKITE_AGENT=ai-commander
# WORKKITE_RISK_REVIEWER=ai
# WORKKITE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# WORKKITE_LLM_MODEL=gemini-flash-latest
# For Mistral, change the URL to https://api.mistral.ai/v1 and the model to
# mistral-small-latest. For another compatible provider, change URL and model.
# Configure the API key only in a local ignored .env or the host's secret store.
WORKKITE_LLM_BASE_URL=
WORKKITE_LLM_MODEL=
WORKKITE_LLM_API_KEY=
# Optional. Gemini 2.5 models can use `none` to reserve generation budget for JSON output.
WORKKITE_LLM_REASONING_EFFORT=

# Required only when an external scheduler calls /api/cron/agent.
# Generate a high-entropy secret and use the same value in the scheduler's
# authorization header. Never commit a real value here.
CRON_SECRET=

# Local-only username sign-in; this does not secure API routes. Never use in production.
# Configure local users in an ignored .env; never include real credentials here.
WORKKITE_LOCAL_USERS_JSON=[]
# Start local testing with a clean company workspace instead of sample solar data.
WORKKITE_LOCAL_EMPTY_WORKSPACE=false
WORKKITE_LOCAL_WORKSPACE_NAME=Workkite workspace
# Keep provider, wallet, and identity secrets out of VITE_* variables.
