# All defaults run locally with no accounts or credentials.
AVERLOCK_DATABASE=./averlock.db
AVERLOCK_AGENT=local
AVERLOCK_WALLET=simulated
# Seconds between background agent cycles; 0 disables the loop.
AVERLOCK_AGENT_INTERVAL=5
# External adapters are extension points, not enabled implementations.
# Never put signing keys or provider secrets in VITE_* variables.
