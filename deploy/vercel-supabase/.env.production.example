# Public client configuration. Enforce access with Supabase RLS.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Server-only values: never prefix these with VITE_.
SUPABASE_DATABASE_URL=YOUR_SERVER_SIDE_DATABASE_CONNECTION
CRON_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_16_CHARACTERS
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_ADMIN_CREDENTIALS=CONFIGURE_AS_PLATFORM_SECRET_OR_SECRET_REFERENCE

# Optional AI risk assessment provider (server only).
WORKKITE_AGENT=rules
WORKKITE_LLM_BASE_URL=
WORKKITE_LLM_MODEL=
WORKKITE_LLM_API_KEY=

# Public Firebase web config and the public web-push certificate key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
