# Public browser configuration. The publishable key is intentionally public;
# all operational API access still requires a verified Supabase Auth session.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Server-only values: never prefix these with VITE_. Use the Supabase
# transaction-pooler connection string for a serverless Vercel runtime.
WORKKITE_ENV=production
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
SUPABASE_DATABASE_URL=YOUR_SUPABASE_TRANSACTION_POOLER_CONNECTION_STRING

# Optional: add this before configuring a Vercel Cron schedule.
CRON_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
